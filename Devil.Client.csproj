<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Devil.Client</AssemblyName>
    <RootNamespace>Devil.Client</RootNamespace>
    <Version>2.0.0</Version>
    <LangVersion>11.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SPTPath Condition="'$(SPTPath)' == ''">S:\SPT</SPTPath>
    <PackageRoot>$(MSBuildProjectDirectory)\..\Build\BepInEx\plugins\DevilCultistOperator</PackageRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
	<Reference Include="0Harmony">
		<HintPath>$(SptBepInExPath)\core\0Harmony.dll</HintPath>
	</Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx" Private="false">
      <HintPath>$(SPTPath)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Comfort" Private="false">
      <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
    </Reference>
	<Reference Include="UnityEngine">
		<HintPath>$(SptManagedPath)\UnityEngine.dll</HintPath>
	</Reference>
	<Reference Include="UnityEngine.CoreModule">
		<HintPath>$(SptManagedPath)\UnityEngine.CoreModule.dll</HintPath>
	</Reference>
	<Reference Include="DrakiaXYZ-BigBrain">
		<HintPath>$(SptBepInExPath)\plugins\DrakiaXYZ-BigBrain.dll</HintPath>
	</Reference>
	<Reference Include="spt-common">
		<HintPath>$(SPTPath)\BepInEx\plugins\spt\spt-common.dll</HintPath>
		<Private>false</Private>
	</Reference>
  </ItemGroup>

  <Target Name="BuildPackage" AfterTargets="Build">
    <MakeDir Directories="$(PackageRoot)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageRoot)" />
  </Target>
</Project>
